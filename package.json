{
  "name": "tooling-control-app",
  "version": "0.2.5",
  "description": "Electron app for tooling control with SQLite database",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder",
    "postinstall": "electron-rebuild"
  },
  "build": {
    "appId": "com.cummins.tooling-control-app",
    "productName": "Tooling Control App",
    "artifactName": "${productName}.${ext}",
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "files": [
      "src/**",
      "assets/**",
      "Fonts/**",
      "package.json",
      "database/ferramental_database.db",
      "ferramental_database.db",
      "images/**",
      "!dist/**",
      "!attachments/**",
      "!**/*.md",
      "!builder-*.yml",
      "!*.blockmap"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/ferramentas.ico"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "keywords": [
    "tooling",
    "cummins",
    "database",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sqlite3": "^5.1.7"
  }
}
